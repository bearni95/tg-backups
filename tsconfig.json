{
	"compilerOptions": {
		"target": "ES2023",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"lib": ["ES2023"],
		"types": ["node", "vitest/globals"],
		"noEmit": true,
		"strict": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"paths": {
			"$lib/*": ["./src/lib/*"],
			"$adapters/*": ["./src/adapters/*"],
			"$types/*": ["./src/types/*"],
			"$utils/*": ["./src/utils/*"]
		}
	},
	"include": ["src", "test", "*.config.ts"]
}
