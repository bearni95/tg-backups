# From https://my.telegram.org/apps (can also be entered in the UI).
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# The tgb group: create a private Telegram group named "tgb" and paste its
# invite link (https://t.me/+...). It is where backups are stored, and only
# its members can use the app.
# Don't put just "tgb" here: a bare word is looked up as a public @username.
TGB_TELEGRAM_ACCESS_GROUP=

# TGB_DATA_DIR=/absolute/path   # default ~/tg-backups
# TGB_PORT=9811
