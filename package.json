{
	"name": "tg-backups",
	"version": "0.2.0",
	"description": "Create and restore zip backups using Telegram groups as storage",
	"type": "module",
	"engines": {
		"node": ">=24"
	},
	"bin": {
		"tgb": "./dist/cli.js"
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"tgb": "tsx src/cli/index.ts",
		"check": "tsc --noEmit",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "vitest run",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"clean": "rm -rf dist"
	},
	"dependencies": {
		"@inquirer/prompts": "^8.8.1",
		"@mtcute/node": "0.32.8",
		"cli-progress": "^3.12.0",
		"commander": "^15.1.0",
		"log-update": "^8.0.0",
		"mime": "^4.1.2",
		"qrcode-generator": "^2.0.4",
		"yazl": "^3.3.1"
	},
	"devDependencies": {
		"@eslint/js": "^9.18.0",
		"@mtcute/tl-runtime": "^0.32.6",
		"@types/cli-progress": "^3.11.6",
		"@types/node": "^24.19.2",
		"@types/yazl": "^3.3.1",
		"@vitest/coverage-v8": "^4.0.6",
		"@vitest/ui": "^4.0.6",
		"eslint": "^9.18.0",
		"prettier": "^3.4.2",
		"tsup": "^9.0.0",
		"tsx": "^4.23.15",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vitest": "^4.0.6"
	}
}
